        }
      }
    },
    "leytouDeepSeek": {
      "env": ["LEYTOU_DEEPSEEK_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "Leytou DeepSeek",
      "settings": {
        "baseURL": "https://api.deepseek.com"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek Flash"
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "chrome-devtools-mcp@latest", "--autoConnect"]
      },
      "figma-framelink": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-developer-mcp@0.13.2",
          "--no-telemetry",
          "--stdio"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        },
        "disabled": true
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim"
  ]
}
