    "cch": {
      "env": ["LEYTOU_CCH_DEEPSEEK_KEY"],
      "package": "@opencode/ai/providers/openai-compatible",
      "name": "CCH",
      "settings": {
        "baseURL": "{env:CCH_URL}/v1"
      },
      "models": {
        "CVTE-AUTO": {
          "name": "CVTE Auto"
        },
        "claude-fable-5.1": {
