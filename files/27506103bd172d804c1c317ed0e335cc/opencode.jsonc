{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "xyz1001": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "{env:XYZ1001_API_URL}/v1"
      },
      "models": {
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna"
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol"
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra"
        }
      }
    },
    "junhua": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "{env:JUNHUA_API_URL}/v1"
      },
      "models": {
        "gpt-image-2": {
          "name": "GPT Image 2"
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna"
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "settings": {
            "reasoningEffort": "max"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra"
        }
      }
    },
    "friendmlx": {
      "package": "aisdk:@ai-sdk/openai",
      "name": "Friend MLX",
      "settings": {
        "baseURL": "http://120.48.144.58:8901/v1",
        "apiKey": "{env:FRIEND_MLX_API_KEY}"
      },
      "models": {
        "MLX-Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-4bit": {
          "name": "MLX Qwen3.5 9B Distilled"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "chrome-devtools-mcp@latest", "--autoConnect"]
      }
    }
  },
  "plugins": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "oh-my-opencode-slim"
  ]
}
