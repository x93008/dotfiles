{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "junhua": {
      "package": "aisdk:@ai-sdk/openai",
      "settings": {
        "baseURL": "https://openai.kadocai.uk/v1"
      },
      "models": {
        "gpt-image-2": {
          "name": "GPT Image 2"
        },
        "gpt-5.6-luna": {
          "name": "GPT 5.6 Luna"
        },
        "gpt-5.6-sol": {
          "name": "GPT 5.6 Sol",
          "settings": {
            "reasoningEffort": "max"
          },
          "variants": [
            {
              "id": "low",
              "settings": {
                "reasoningEffort": "low"
              }
            },
            {
              "id": "medium",
              "settings": {
                "reasoningEffort": "medium"
              }
            },
            {
              "id": "high",
              "settings": {
                "reasoningEffort": "high"
              }
            },
            {
              "id": "xhigh",
              "settings": {
                "reasoningEffort": "xhigh"
              }
            },
            {
              "id": "max",
              "settings": {
                "reasoningEffort": "max"
              }
            }
          ]
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra"
        },
        "codex-auto-review": {
          "name": "Codex Auto Review"
        },
        "gpt-4o-audio-preview": {
          "name": "gpt-4o-audio-preview"
        },
        "gpt-4o-realtime-preview": {
          "name": "gpt-4o-realtime-preview"
        },
        "gpt-5.2": {
          "name": "GPT-5.2"
        },
        "gpt-5.2-2025-12-11": {
          "name": "gpt-5.2-2025-12-11"
        },
        "gpt-5.2-chat-latest": {
          "name": "gpt-5.2-chat-latest"
        },
        "gpt-5.2-pro": {
          "name": "gpt-5.2-pro"
        },
        "gpt-5.2-pro-2025-12-11": {
          "name": "gpt-5.2-pro-2025-12-11"
        },
        "gpt-5.3-codex-spark": {
          "name": "GPT-5.3 Codex Spark"
        },
        "gpt-5.4": {
          "name": "GPT-5.4"
        },
        "gpt-5.4-2026-03-05": {
          "name": "gpt-5.4-2026-03-05"
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini"
        },
        "gpt-5.5": {
          "name": "GPT-5.5"
        },
        "gpt-5.6": {
          "name": "GPT-5.6 (Sol)"
        },
        "gpt-6": {
          "name": "GPT-6 (Astra)"
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra"
        },
        "gpt-6-luna": {
          "name": "GPT-6 Luna"
        },
        "gpt-6-sol": {
          "name": "GPT-6 Sol"
        },
        "gpt-image-1": {
          "name": "GPT Image 1"
        },
        "gpt-image-1.5": {
          "name": "GPT Image 1.5"
        },
        "gpt-image-2.5-flare": {
          "name": "GPT Image 2.5 Flare"
        },
        "gpt-image-2.5-sunburst": {
          "name": "GPT Image 2.5 Sunburst"
        }
      }
    },
    "friendmlx": {
      "package": "aisdk:@ai-sdk/openai",
      "name": "Friend MLX",
      "settings": {
        "baseURL": "http://120.48.144.58:8901/v1",
        "apiKey": "{env:FRIEND_MLX_API_KEY}"
      },
      "models": {
        "MLX-Qwen3.5-9B-Claude-4.6-Opus-Reasoning-Distilled-4bit": {
          "name": "MLX Qwen3.5 9B Distilled"
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "chrome-devtools-mcp@latest", "--autoConnect"]
      },
      "figma-framelink": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "figma-developer-mcp@0.13.2",
          "--no-telemetry",
          "--stdio"
        ],
        "environment": {
          "FIGMA_API_KEY": "{env:FIGMA_API_KEY}"
        },
        "disabled": true
      }
    }
  },
  "plugins": [
    "oh-my-opencode-slim"
  ]
}
