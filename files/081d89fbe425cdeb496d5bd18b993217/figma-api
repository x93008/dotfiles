def handle_raw(client: FigmaClient, args: Sequence[str]) -> None:
    _require_args(args, 1, 1, "raw </endpoint>")
    endpoint = args[0]
    if not endpoint.startswith("/") or endpoint.startswith("//") or "://" in endpoint:
        raise UsageError("raw endpoint must be an API path beginning with '/'.")
    eprint("GET {}".format(endpoint))
    raw, _headers = client.get_bytes(endpoint)
    try:
        parsed = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        # Exactly one request: non-JSON bytes are emitted as received.
        sys.stdout.flush()
        sys.stdout.buffer.write(raw)
        sys.stdout.buffer.flush()
        return
    print(json.dumps(parsed, indent=4, ensure_ascii=False))


TOKEN_GUIDE = """Figma Personal Access Token setup:
  1. Open Figma Settings and create a Personal Access Token with the scopes
     needed for the files and resources you intend to read.
  2. Run: figma-api token set
     The token is read from a hidden prompt. By default, GET /v1/me is used
     only as an identity/current_user:read scope check, not as a general token
     validation. A file-only token can receive HTTP 403 from /me and will be
     saved with an identity-check warning.
  3. To skip the /me request, run: figma-api token set --no-verify
For automation, set FIGMA_TOKEN instead of passing a token as an argument.
Official docs: https://developers.figma.com/docs/rest-api/personal-access-tokens/"""


def _save_token_file(path: Path, value: str) -> None:
    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        if os.name != "nt":
            os.chmod(path.parent, 0o700)
    except OSError as exc:
        raise FileOperationError("Cannot create token directory '{}': {}".format(path.parent, exc)) from None
    atomic_write_bytes(path, (value + "\n").encode("utf-8"), mode=stat.S_IRUSR | stat.S_IWUSR)


def handle_token(
    args: Sequence[str],
    home: Optional[Path] = None,
    prompt: Optional[Callable[[str], str]] = None,
    api_opener: Optional[Callable[..., Any]] = None,
) -> None:
    path = token_path(home)
    if not args:
        print("Token management:")
        print("  figma-api token set [--no-verify]  Set a token using a hidden prompt")
        print("  figma-api token show               Show the active token, safely masked")
        print("  figma-api token remove             Remove the saved token file")
        print("  Default set checks identity through /me (requires current_user:read).")
        print("  File-only tokens may get HTTP 403 from /me and are saved with a warning.")
        print("  Automation should use FIGMA_TOKEN; tokens are never positional arguments.")
        env_token = os.environ.get("FIGMA_TOKEN", "").strip()
        if env_token:
            print("Active token: {} (FIGMA_TOKEN)".format(mask_token(env_token)))
        elif path.is_file():
            try:
                saved = path.read_text(encoding="utf-8").strip()
            except OSError:
                print("Saved token: unreadable ({})".format(path))
            else:
                print("Saved token: {} ({})".format(mask_token(saved), path))
        else:
            print("Status: not configured")
            print(TOKEN_GUIDE)
        return

    action = args[0]
    if action == "set":
        set_args = list(args[1:])
        if set_args not in ([], ["--no-verify"]):
            raise UsageError("Usage: {} token set [--no-verify]".format(PROGRAM))
        no_verify = set_args == ["--no-verify"]
        try:
            value = (prompt if prompt is not None else getpass.getpass)("Figma token: ").strip()
        except (EOFError, KeyboardInterrupt):
            raise AuthError("Token input was cancelled.") from None
        if not value:
            raise UsageError("Token must not be empty.")
        profile: Dict[str, Any] = {}
        identity_checked = False
        warning = ""
        if no_verify:
            warning = (
                "Warning: token saved unverified (--no-verify); no identity check or network request "
                "was performed."
            )
        else:
            eprint("Checking identity and current_user:read access with Figma /me...")
            # /me is an identity/scope check only. In particular, a token that
            # can read files may legitimately lack current_user:read.
            try:
                client = FigmaClient(value) if api_opener is None else FigmaClient(value, opener=api_opener)
                profile = as_dict(client.get_json("/me"))
                identity_checked = True
            except AuthError as exc:
                if exc.status == 403:
                    warning = (
                        "Warning: token saved without identity verification because Figma /me returned "
                        "HTTP 403. It may lack current_user:read or be subject to another authorization "
                        "restriction."
                    )
                elif exc.status == 401:
                    safe_detail = _safe_api_detail(exc.detail, value)
                    reason = "HTTP 401{}".format(": " + safe_detail if safe_detail else "")
                    raise AuthError(
                        "Figma /me identity check failed; the token was not saved. {}. To save without "
                        "this identity check, explicitly use '{} token set --no-verify'.".format(
                            reason, PROGRAM
                        ),
                        status=401,
                        detail=safe_detail,
                    ) from None
                else:
                    raise AuthError(
                        "The Figma /me identity check could not be started: {} The token was not saved. "
                        "Correct the input or use '{} token set --no-verify'.".format(
                            exc.message, PROGRAM
                        ),
                        status=exc.status,
                    ) from None
            except ApiError as exc:
                raise ApiError(
                    "The Figma /me identity check could not be completed: {} The token was not saved. "
                    "Retry later or use '{} token set --no-verify' to save without the identity check.".format(
                        exc.message, PROGRAM
                    ),
                    status=exc.status,
                ) from None

        _save_token_file(path, value)
        print("Token saved to {}".format(path))
        if identity_checked:
            identity = _safe_api_detail(
                profile.get("handle") or profile.get("email") or profile.get("id"), value
            )
            print("Current user: {}".format(identity or "(not provided by /me)"))
        if warning:
            eprint(warning)
        return
    if action == "show":
        _require_args(args, 1, 1, "token show")
        env_token = os.environ.get("FIGMA_TOKEN", "").strip()
        if env_token:
            print("Token source: FIGMA_TOKEN")
            print("Token: {}".format(mask_token(env_token)))
            return
        try:
            saved = path.read_text(encoding="utf-8").strip()
        except FileNotFoundError:
            print("Token is not configured.")
            print(TOKEN_GUIDE)
            return
        except OSError as exc:
            raise FileOperationError("Cannot read token file '{}': {}".format(path, exc)) from None
        print("Token file: {}".format(path))
        print("Token: {}".format(mask_token(saved)))
        return
    if action in {"remove", "rm"}:
        _require_args(args, 1, 1, "token remove")
        try:
            path.unlink()
        except FileNotFoundError:
            print("Token file does not exist: {}".format(path))
        except OSError as exc:
            raise FileOperationError("Cannot remove token file '{}': {}".format(path, exc)) from None
        else:
            print("Token removed: {}".format(path))
        if os.environ.get("FIGMA_TOKEN", "").strip():
            eprint("Note: FIGMA_TOKEN is still set in the environment and was not modified.")
        return
    raise UsageError("Unknown token action '{}'. Use set, show, or remove.".format(action))


def _known_install_entries(home: Path) -> List[Path]:
    return [
        home / ".local" / "bin" / "figma-api",
        home / ".local" / "bin" / "figma-api.py",
        home / ".local" / "bin" / "figma-api.ps1",
        home / ".local" / "bin" / "figma-api.bat",
        home / ".local" / "bin" / "figma-api.cmd",
        home / ".claude" / "tools" / "figma-api" / "figma-api.py",
        home / ".claude" / "tools" / "figma-api" / "figma.sh",
        home / ".claude" / "tools" / "figma-api" / "figma.ps1",
    ]


def _is_workspace_source(path: Path, current_script: Path) -> bool:
    try:
        resolved = path.resolve(strict=False)
    except OSError:
        return False
    return (
        resolved == current_script
        and resolved.parent.name == "tools"
        and (resolved.parent.parent / "AGENTS.md").is_file()
    )


def _is_proven_install_entry(path: Path, current_script: Path) -> Tuple[bool, str]:
    """Prove ownership without trusting a guessed filename alone."""
    if path.is_symlink():
        try:
            target = path.resolve(strict=True)
        except OSError:
            return False, "symlink target is missing or unreadable"
        if target == current_script:
            return True, "symlink to current script"
        return False, "symlink does not resolve to the current script"
    if not path.is_file():
        return False, "not a regular file or symlink"
    if _is_workspace_source(path, current_script):
        return False, "workspace source is protected"
    try:
        if path.stat().st_size > 2 * 1024 * 1024:
            return False, "file is too large to be a tool entry"
        content = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        return False, "file content is unreadable"
    if INSTALL_MARKER_LINE in content.splitlines():
        return True, "explicit figma-api install marker"
    try:
        current_content = current_script.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        current_content = ""
    if current_content and content == current_content:
        return True, "exact current-script content"
    return False, "content has no matching install marker"


def handle_uninstall(
    args: Sequence[str], home: Optional[Path] = None, scan_global: bool = True
) -> None:
    force = False
    for arg in args:
        if arg in {"--force", "-f"}:
            force = True
        else:
            raise UsageError("Unknown uninstall option: {}".format(arg))
    user_home = home if home is not None else Path.home()
    current_script = Path(__file__).resolve(strict=False)
    removable: List[Tuple[str, Path]] = []
    skipped: List[Tuple[Path, str]] = []
    saved_token = token_path(user_home)
    if saved_token.exists() or saved_token.is_symlink():
        removable.append(("token", saved_token))
    install_entries = _known_install_entries(user_home)
    if scan_global and os.name != "nt":
        install_entries.append(Path("/usr/local/bin/figma-api"))
    for entry in install_entries:
        if entry.exists() or entry.is_symlink():
            proven, reason = _is_proven_install_entry(entry, current_script)
            if proven:
                removable.append(("verified install entry", entry))
            else:
                skipped.append((entry, reason))

    print("Figma API CLI uninstall")
    print("=======================")
    if skipped:
        print("Unverified same-name entries will be skipped:")
        for path, reason in skipped:
            print("  [skip] {} ({})".format(path, reason))
    if not removable:
        print("No token or verified install entries were found.")
        print("Shell RC, PATH, AI configuration, and unverified files are untouched.")
        return
    print("The following verified files will be removed:")
    for label, path in removable:
        print("  [{}] {}".format(label, path))
    print("Shell RC, PATH, and AI configuration files will not be modified.")
    if not force:
        try:
            answer = input("Confirm uninstall? (y/N): ").strip().lower()
        except EOFError:
            answer = ""
        if answer != "y":
            print("Cancelled.")
            return

    failures: List[Path] = []
    for _label, path in removable:
        try:
            path.unlink()
        except FileNotFoundError:
            continue
        except OSError:
            failures.append(path)
            eprint("Could not remove: {}".format(path))
        else:
            print("Removed: {}".format(path))
    if failures:
        raise FileOperationError("Uninstall was incomplete; {} item(s) could not be removed.".format(len(failures)))
    print("Uninstall complete.")


