            and "--no-verify" in token_401_error.message
            and not token_path(token_home_401).exists(),
        )
        check(
            "token set preserves exact expired-token API detail",
            token_401_error is not None
            and token_401_error.detail == "Token has expired"
            and "HTTP 401: Token has expired" in token_401_error.message
            and "check token" not in token_401_error.message.lower(),
        )
        token_401_messages = (
            token_401_stdout.getvalue()
            + token_401_stderr.getvalue()
            + (token_401_error.message if token_401_error is not None else "")
        )
        check("token set /me 401 output redacts token", token_401 not in token_401_messages)

        token_no_verify = "figd_self_test_no_verify_secret"
        token_home_no_verify = root / "token-home-no-verify"
        no_verify_network_calls = [0]

        def no_verify_open(request: Request, timeout: float = 0) -> Any:
            del request, timeout
            no_verify_network_calls[0] += 1
            raise AssertionError("--no-verify attempted a network request")

        no_verify_stdout = io.StringIO()
        no_verify_stderr = io.StringIO()
        with contextlib.redirect_stdout(no_verify_stdout), contextlib.redirect_stderr(no_verify_stderr):
            handle_token(
                ["set", "--no-verify"],
                home=token_home_no_verify,
                prompt=lambda _label: token_no_verify,
                api_opener=no_verify_open,
            )
        no_verify_file = token_path(token_home_no_verify)
        check(
            "token set --no-verify saves without network",
            no_verify_network_calls[0] == 0
            and no_verify_file.read_text(encoding="utf-8") == token_no_verify + "\n"
            and "saved unverified" in no_verify_stderr.getvalue(),
        )
        check(
            "token set --no-verify output redacts token",
            token_no_verify not in no_verify_stdout.getvalue()
            and token_no_verify not in no_verify_stderr.getvalue(),
        )
        if os.name != "nt":
            check(
                "token set --no-verify mode 0600",
                stat.S_IMODE(no_verify_file.stat().st_mode) == 0o600,
            )

        body = b"offline-download-bytes"
        download_requests: List[Request] = []

        def fake_open(request: Request, timeout: float = 0) -> _FakeDownloadResponse:
            del timeout
            download_requests.append(request)
            return _FakeDownloadResponse(body, "image/png", "https://assets.example/final.png")

        destination = root / "download.bin"
        result = download_atomic("https://assets.example/start", destination, opener=fake_open)
        check("fake download bytes", destination.read_bytes() == body and result.size == len(body))
        check("download atomic temp cleanup", not list(root.glob(".download.bin-*.tmp")))
        download_headers = {key.lower(): value for key, value in download_requests[0].header_items()}
        check(
            "CDN download GET has no token",
            download_requests[0].get_method() == "GET" and "x-figma-token" not in download_headers,
        )
        if os.name != "nt":
            check("download mode 0644", stat.S_IMODE(destination.stat().st_mode) == 0o644)

        first_stage = download_to_temp(
            "https://assets.example/one", root, prefix=".asset-stage-", opener=fake_open
        )
        second_stage = download_to_temp(
            "https://assets.example/two", root, prefix=".asset-stage-", opener=fake_open
        )
        try:
            check(
                "random exclusive staging paths",
                first_stage.path != second_stage.path
                and first_stage.path.is_file()
                and second_stage.path.is_file(),
            )
        finally:
            remove_staged_download(first_stage)
            remove_staged_download(second_stage)
        check("random staging cleanup", not list(root.glob(".asset-stage-*.tmp")))

        def failing_open(request: Request, timeout: float = 0) -> Any:
            del request, timeout
            raise URLError("offline failure")

        failed_destination = root / "failed.bin"
        try:
            download_atomic("https://assets.example/fail", failed_destination, opener=failing_open)
        except FileOperationError:
            pass
        else:
            failures.append("fake failed download raises")
        check("failed download absent", not failed_destination.exists())
        check("failed download temp cleanup", not list(root.glob(".failed.bin-*.tmp")))

        small_svg = b'<svg xmlns="http://www.w3.org/2000/svg" width="1" height="1"/>'
        small_png = base64.b64decode(
            "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mNk+A8AAQUBAScY42YAAAAASUVORK5CYII="
        )

        class DirectExportClient:
            def __init__(self, url: str) -> None:
                self.url = url
                self.calls: List[Tuple[str, Optional[Mapping[str, Any]]]] = []

            def get_json(self, endpoint: str, params: Optional[Mapping[str, Any]] = None) -> Any:
                self.calls.append((endpoint, params))
                requested_id = text((params or {}).get("ids"))
                return {"images": {requested_id: self.url}}

        def payload_opener(payload: bytes, content_type: str) -> Callable[..., Any]:
            def open_payload(request: Request, timeout: float = 0) -> _FakeDownloadResponse:
                del timeout
                return _FakeDownloadResponse(payload, content_type, request.full_url)

            return open_payload

        svg_client = DirectExportClient("https://assets.example/direct.svg")
        svg_output = root / "small.svg"
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            handle_export(
                svg_client,  # type: ignore[arg-type]
                ["ARG", "7:8", "svg", "2", str(svg_output)],
                download_opener=payload_opener(small_svg, "image/svg+xml"),
            )
        check(
            "valid small SVG keeps requested node",
            svg_output.read_bytes() == small_svg and len(svg_client.calls) == 1,
        )

        png_client = DirectExportClient("https://assets.example/direct.png")
        png_output = root / "small.png"
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            handle_export(
                png_client,  # type: ignore[arg-type]
                ["ARG", "7:8", "png", "2", str(png_output)],
                download_opener=payload_opener(small_png, "image/png"),
            )
        check(
            "valid small PNG keeps requested node",
            png_output.read_bytes() == small_png and len(png_client.calls) == 1,
        )

        class InvalidExportClient:
            def __init__(self) -> None:
                self.image_calls = 0

            def get_json(self, endpoint: str, params: Optional[Mapping[str, Any]] = None) -> Any:
                if endpoint == "/files/ARG":
                    return {
                        "document": {
                            "id": "0:1",
                            "children": [{"id": "7:8", "children": []}],
                        }
                    }
                if endpoint == "/images/ARG":
                    self.image_calls += 1
                    requested_ids = text((params or {}).get("ids"))
                    first_id = requested_ids.split(",", 1)[0]
                    return {
                        "images": {
                            first_id: "https://assets.example/invalid-{}.png".format(self.image_calls)
                        }
                    }
                raise AssertionError("unexpected fake endpoint: {}".format(endpoint))

        invalid_download_count = [0]

        def invalid_image_open(request: Request, timeout: float = 0) -> _FakeDownloadResponse:
            del timeout
            invalid_download_count[0] += 1
            return _FakeDownloadResponse(
                b"<html>not an image</html>", "text/html", request.full_url
            )

        preserved_output = root / "preserve.png"
        preserved_output.write_bytes(b"existing-output")
        invalid_client = InvalidExportClient()
        try:
            with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
                handle_export(
                    invalid_client,  # type: ignore[arg-type]
                    ["ARG", "7:8", "png", "2", str(preserved_output)],
                    download_opener=invalid_image_open,
                )
        except FileOperationError:
            pass
        else:
            failures.append("invalid exports must fail")
        check(
            "invalid fallback downloads preserve old target",
            preserved_output.read_bytes() == b"existing-output" and invalid_download_count[0] >= 4,
        )
        check(
            "invalid fallback staging cleanup",
            not list(root.glob(".preserve.png-candidate-*.tmp")),
        )

        asset_result = _download_asset(
            "asset-ref",
            "https://assets.example/image.png",
            root,
            opener=payload_opener(small_png, "image/png"),
        )
        check("asset random staging committed", asset_result.path.read_bytes() == small_png)
        check("asset staging cleanup", not list(root.glob(".asset-ref-asset-*.tmp")))
        if os.name != "nt":
            check("asset mode 0644", stat.S_IMODE(asset_result.path.stat().st_mode) == 0o644)

        secure_file = root / "secure-token-mode"
        atomic_write_bytes(secure_file, b"secret\n", mode=0o600)
        if os.name != "nt":
            check("token-style atomic mode 0600", stat.S_IMODE(secure_file.stat().st_mode) == 0o600)

        uninstall_home = root / "uninstall-home"
        install_bin = uninstall_home / ".local" / "bin"
        install_bin.mkdir(parents=True)
        unverified_entry = install_bin / "figma-api"
        unverified_entry.write_text("unrelated user file\n", encoding="utf-8")
        verified_entry = install_bin / "figma-api.py"
        verified_entry.write_text(INSTALL_MARKER_LINE + "\n", encoding="utf-8")
        uninstall_token = token_path(uninstall_home)
        uninstall_token.parent.mkdir(parents=True)
        uninstall_token.write_text("offline-placeholder\n", encoding="utf-8")
        uninstall_stdout = io.StringIO()
        synthetic_workspace = root / "workspace"
        synthetic_tools = synthetic_workspace / "tools"
        synthetic_tools.mkdir(parents=True)
        (synthetic_workspace / "AGENTS.md").write_text("offline fixture\n", encoding="utf-8")
        synthetic_source = synthetic_tools / "figma-api.py"
        synthetic_source.write_text(INSTALL_MARKER_LINE + "\n", encoding="utf-8")
        check(
            "workspace source classified as protected",
            not _is_proven_install_entry(
                synthetic_source, synthetic_source.resolve(strict=False)
            )[0],
        )
        with contextlib.redirect_stdout(uninstall_stdout), contextlib.redirect_stderr(io.StringIO()):
            handle_uninstall(["--force"], home=uninstall_home, scan_global=False)
        check(
            "uninstall removes only proven entries/token",
            unverified_entry.is_file()
            and not verified_entry.exists()
            and not uninstall_token.exists()
            and "[skip]" in uninstall_stdout.getvalue(),
        )
        check("uninstall never removes workspace source", Path(__file__).is_file())

    if failures:
        for failure in failures:
            eprint("FAIL: {}".format(failure))
        eprint("Self-test: {} passed, {} failed".format(passed, len(failures)))
        return 1
    print("Self-test: {} passed, 0 failed (offline)".format(passed))
    return 0


def run_self_test() -> int:
    """Run deterministic tests with a temporary HOME and no network access."""
    saved_home = {name: os.environ.get(name) for name in ("HOME", "USERPROFILE")}
    with tempfile.TemporaryDirectory(prefix="figma-api-self-test-home-") as temporary_home:
        os.environ["HOME"] = temporary_home
        os.environ["USERPROFILE"] = temporary_home
        try:
            return _run_self_test_body()
        finally:
            for name, previous in saved_home.items():
                if previous is None:
                    os.environ.pop(name, None)
                else:
                    os.environ[name] = previous


def preflight_command(command: str, args: Sequence[str]) -> None:
    """Validate command syntax before token loading or any network request."""
    if command == "screenshot":
        parse_export_arguments(args, screenshot=True, validate_output=False)
        return
    if command == "export":
        parse_export_arguments(args, screenshot=False, validate_output=False)
        return
    if command == "layout":
        positionals, _flags, _switches = split_flags(args, set(), {"--json"})
        _file_key, _node_id, remaining = parse_file_and_node(positionals, "layout")
        if remaining:
            raise UsageError("Usage: {} layout <url> [--json]".format(PROGRAM))
        return
    if command == "images":
        positionals, _flags, _switches = split_flags(args, set())
        _file_key, _node_id, remaining = parse_file_and_node(positionals, "images")
        if len(remaining) > 1:
            raise UsageError("Usage: {} images <url> [output_dir]".format(PROGRAM))
        return

    file_commands = {
        "file-info", "file-meta", "comments", "versions", "file-components",
        "file-component-sets", "file-styles", "variables-local", "variables-published",
    }
    if command in file_commands:
        _require_args(args, 1, 1, "{} <url|file_key>".format(command))
        get_file_key(args[0])
        return
    if command == "comment-reactions":
        _require_args(args, 2, 2, "comment-reactions <url|file_key> <comment_id>")
        get_file_key(args[0])
        validate_identifier(args[1], "comment ID")
        return
    if command == "me":
        _require_args(args, 0, 0, "me")
        return

    identifier_labels = {
        "team-projects": "team ID",
        "project-files": "project ID",
        "team-components": "team ID",
        "component": "component key",
        "team-component-sets": "team ID",
        "component-set": "component set key",
        "team-styles": "team ID",
        "style": "style key",
    }
    if command in identifier_labels:
        _require_args(args, 1, 1, "{} <identifier>".format(command))
        validate_identifier(args[0], identifier_labels[command])
        return
    if command == "dev-resources":
        _require_args(args, 1, 2, "dev-resources <url|file_key> [node_id]")
        if looks_like_url(args[0]):
            parsed = parse_figma_url(args[0])
            if len(args) == 2 and parsed.node_id:
                raise UsageError("node ID was supplied in both URL and positional arguments.")
        else:
            validate_identifier(args[0], "file key")
        if len(args) == 2:
            validate_identifier(args[1], "node ID")
        return
    if command == "analytics":
        _require_args(args, 1, 3, "analytics <url|file_key> [type] [action]")
        get_file_key(args[0])
        item_type = args[1] if len(args) > 1 else "component"
        action = args[2] if len(args) > 2 else "usages"
        if item_type not in {"component", "style", "variable"}:
            raise UsageError("analytics type must be component, style, or variable.")
        if action not in {"actions", "usages"}:
            raise UsageError("analytics action must be actions or usages.")
        return
    if command == "raw":
        _require_args(args, 1, 1, "raw </endpoint>")
        endpoint = args[0]
        if not endpoint.startswith("/") or endpoint.startswith("//") or "://" in endpoint:
            raise UsageError("raw endpoint must be an API path beginning with '/'.")
        return
    raise UsageError("Unsupported command: {}".format(command))


def main(argv: Optional[Sequence[str]] = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    try:
        if not arguments or arguments[0] in {"help", "-h", "--help"}:
            if len(arguments) > 1:
                raise UsageError("help does not accept additional arguments.")
            print(HELP_TEXT)
            return 0
        if arguments[0] in {"self-test", "--self-test"}:
            if len(arguments) != 1:
                raise UsageError("self-test does not accept additional arguments.")
            return run_self_test()

        requested = arguments[0]
        rest = arguments[1:]
        if requested == "token":
            handle_token(rest)
            return 0
        if requested == "url":
            handle_url(rest)
            return 0
        if requested == "uninstall":
            handle_uninstall(rest)
            return 0

        command = ALIASES.get(requested)
        if command is None:
            raise UsageError("Unknown command '{}'. Run '{} help' for usage.".format(requested, PROGRAM))

        # Validate syntax first so missing credentials never mask a usage error.
        preflight_command(command, rest)
        client = FigmaClient(load_token())
        if command == "screenshot":
            handle_export(client, rest, screenshot=True)
        elif command == "export":
            handle_export(client, rest, screenshot=False)
        else:
            AUTH_HANDLERS[command](client, rest)
        return 0
    except CliError as exc:
        eprint("Error: {}".format(exc.message))
        return exc.code
    except BrokenPipeError:
        try:
            sys.stderr.close()
        except OSError:
            pass
        return 0
    except KeyboardInterrupt:
        eprint("Error: cancelled.")
        return 130
    except Exception:
        # Avoid dumping request internals or credentials from an unexpected
        # urllib exception.  Expected failures above carry precise categories.
        eprint("Error: unexpected internal failure.")
        return EXIT_HTTP


if __name__ == "__main__":
    sys.exit(main())
