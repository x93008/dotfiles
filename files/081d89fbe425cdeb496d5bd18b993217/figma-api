USER_AGENT = "figma-api-python/3.0"
DEFAULT_TIMEOUT = 30.0
INSTALL_MARKER_LINE = "# FIGMA_API_INSTALL_MARKER: figma-api-python-v3-read-only"

EXIT_USAGE = 2
EXIT_AUTH = 3
EXIT_HTTP = 4
EXIT_FILE = 5


class CliError(Exception):
    """An expected error with a stable process exit category."""

    def __init__(self, message: str, code: int) -> None:
        super().__init__(message)
        self.message = message
        self.code = code


class UsageError(CliError):
    def __init__(self, message: str) -> None:
        super().__init__(message, EXIT_USAGE)


class AuthError(CliError):
    def __init__(self, message: str, status: Optional[int] = None, detail: str = "") -> None:
        super().__init__(message, EXIT_AUTH)
        # Keep the HTTP status as structured data so callers never need to
        # infer authorization outcomes by parsing a human-readable message.
        self.status = status
        self.http_status = status
        # API-provided detail is stored only after _safe_api_detail processing.
        self.detail = detail


class ApiError(CliError):
    def __init__(self, message: str, status: Optional[int] = None) -> None:
        super().__init__(message, EXIT_HTTP)
        self.status = status
        self.http_status = status


class FileOperationError(CliError):
    def __init__(self, message: str) -> None:
        super().__init__(message, EXIT_FILE)


def eprint(*values: object) -> None:
    print(*values, file=sys.stderr)


def text(value: Any) -> str:
    return "" if value is None else str(value)


def as_dict(value: Any) -> Dict[str, Any]:
    return value if isinstance(value, dict) else {}


def as_list(value: Any) -> List[Any]:
    return value if isinstance(value, list) else []


def token_path(home: Optional[Path] = None) -> Path:
    return (home if home is not None else Path.home()) / ".config" / "figma" / "token"


def mask_token(token: str) -> str:
    """Mask a token without exposing overlapping portions of short values."""
    value = token.strip()
    if not value:
        return "(empty)"
    if not re.fullmatch(r"[A-Za-z0-9_.-]+", value):
        return "*" * min(max(len(value), 1), 12)
    if len(value) <= 12:
        return "*" * len(value)
    return value[:8] + "..." + value[-4:]


@dataclass(frozen=True)
class ParsedFigmaUrl:
    file_key: str
    node_id: str = ""


VALID_FIGMA_HOSTS = {"figma.com", "www.figma.com"}


def normalize_url_node_id(value: str) -> str:
    # Query parsing has already decoded %3A/%3B.  Figma share links represent
    # ordinary IDs as X-Y while API IDs use X:Y.
    return value.replace("-", ":")


def parse_figma_url(url: str) -> ParsedFigmaUrl:
    """Strictly parse a Figma /design/ or legacy /file/ URL."""
    if not url:
        raise UsageError("Figma URL is required.")
    try:
        parsed = urlsplit(url)
        host = parsed.hostname.lower() if parsed.hostname else ""
        # Accessing .port also detects malformed/non-numeric ports.
        port = parsed.port
    except (ValueError, AttributeError) as exc:
        raise UsageError("Invalid Figma URL.") from exc
    if parsed.scheme.lower() not in {"http", "https"}:
        raise UsageError("Invalid Figma URL: expected http:// or https://.")
    if host not in VALID_FIGMA_HOSTS or parsed.username or parsed.password or port is not None:
        raise UsageError("Not a valid figma.com URL.")

    match = re.match(r"^/(?:design|file)/([^/]+)(?:/.*)?$", parsed.path)
    if not match:
        raise UsageError("Invalid Figma URL: expected /design/FILE_KEY or /file/FILE_KEY.")
    # URL path segments are intentionally decoded by hand only after the host
    # and path shape have been accepted.
    file_key = unquote(match.group(1)).strip()
    if not file_key or "/" in file_key or "\\" in file_key:
        raise UsageError("Invalid Figma URL: file key is missing or malformed.")

    node_id = ""
    # Split only on '&'.  Older Python 3.9 patch levels may treat ';' as a
    # query separator, but raw semicolons are meaningful in Instance IDs.
    for field in parsed.query.split("&"):
        raw_key, separator, raw_value = field.partition("=")
        if separator and unquote_plus(raw_key) == "node-id":
            node_id = normalize_url_node_id(unquote_plus(raw_value).strip())
            break
    return ParsedFigmaUrl(file_key=file_key, node_id=node_id)


def urlencode_node_id(node_id: str) -> str:
    """Encode a node ID as expected by Figma query parameters."""
    return quote(node_id, safe="")


def looks_like_url(value: str) -> bool:
    return value.lower().startswith(("http://", "https://")) or "://" in value


def validate_identifier(value: str, label: str) -> str:
    value = value.strip()
    if not value:
        raise UsageError("{} is required.".format(label))
    if any(ord(char) < 32 for char in value):
        raise UsageError("{} contains invalid control characters.".format(label))
    return value


def get_file_key(value: str) -> str:
    if looks_like_url(value):
        return parse_figma_url(value).file_key
    return validate_identifier(value, "file key")


def parse_file_and_node(values: Sequence[str], command: str) -> Tuple[str, str, List[str]]:
    if not values:
        raise UsageError("{} requires a Figma URL, or a file key and node ID.".format(command))
    first = values[0]
    if looks_like_url(first):
        parsed = parse_figma_url(first)
        if not parsed.node_id:
            raise UsageError(
                "node-id is required; include ?node-id=X-Y in the URL or pass file_key and node_id separately."
            )
        return parsed.file_key, parsed.node_id, list(values[1:])
    if len(values) < 2:
        raise UsageError("{} requires both file_key and node_id.".format(command))
    return (
        validate_identifier(first, "file key"),
        validate_identifier(values[1], "node ID"),
        list(values[2:]),
    )


def endpoint_segment(value: str) -> str:
    return quote(validate_identifier(value, "identifier"), safe="")


def _safe_api_detail(value: Any, token: str) -> str:
    detail = "".join(character if character.isprintable() else " " for character in text(value)).strip()
    if token:
        detail = detail.replace(token, "[REDACTED]")
    return detail[:300]


def _auth_api_message(status: int, detail: str) -> str:
    if detail:
        return "Figma API HTTP {}: {}".format(status, detail)
    category = "authentication failed" if status == 401 else "authorization failed"
    return "Figma API HTTP {}: {}".format(status, category)


def _url_origin(url: str) -> Tuple[str, str, int]:
    """Return a normalized (scheme, host, port) origin or raise ApiError."""
    try:
        parsed = urlsplit(url)
        scheme = parsed.scheme.lower()
        host = parsed.hostname.lower() if parsed.hostname else ""
        port = parsed.port
    except (ValueError, AttributeError) as exc:
        raise ApiError("Figma API redirect target is malformed.") from exc
    if scheme not in {"http", "https"} or not host or parsed.username or parsed.password:
        raise ApiError("Figma API redirect target is not a safe HTTP origin.")
    if port is None:
        port = 443 if scheme == "https" else 80
    return scheme, host, port


class SafeApiRedirectHandler(HTTPRedirectHandler):
    """Allow API redirects only within the exact origin and never downgrade TLS."""

    def redirect_request(
        self,
        request: Request,
        file_pointer: Any,
        code: int,
        message: str,
        headers: Mapping[str, str],
        new_url: str,
    ) -> Optional[Request]:
        old_origin = _url_origin(request.full_url)
        new_origin = _url_origin(new_url)
        if old_origin[0] == "https" and new_origin[0] != "https":
            raise ApiError("Refusing HTTPS-to-HTTP redirect for an authenticated Figma API request.")
        if old_origin != new_origin:
            raise ApiError("Refusing cross-origin redirect for an authenticated Figma API request.")
        redirected = super().redirect_request(request, file_pointer, code, message, headers, new_url)
        if redirected is None:
            return None
        if redirected.get_method() != "GET":
            raise ApiError("Refusing redirect that changes the Figma API request method.")
        return redirected


def build_safe_api_opener() -> Callable[..., Any]:
    """Create the authenticated API opener with the restricted redirect policy."""
    return build_opener(SafeApiRedirectHandler()).open


class FigmaClient:
    """Small urllib-based client.  Every API operation is a GET."""

    def __init__(
        self,
        token: str,
        timeout: float = DEFAULT_TIMEOUT,
        opener: Optional[Callable[..., Any]] = None,
    ) -> None:
        if not token:
            raise AuthError("Figma token is missing.")
        if any(ord(character) < 32 or ord(character) == 127 for character in token):
            raise AuthError("Figma token is malformed.")
        try:
            token.encode("ascii")
        except UnicodeEncodeError:
            raise AuthError("Figma token is malformed.") from None
        self._token = token
        self.timeout = timeout
        self._opener = opener if opener is not None else build_safe_api_opener()

    @staticmethod
    def _build_url(endpoint: str, params: Optional[Mapping[str, Any]] = None) -> str:
        if not endpoint.startswith("/") or endpoint.startswith("//") or "://" in endpoint:
            raise UsageError("API endpoint must be a path beginning with '/'.")
        if any(character.isspace() or ord(character) < 32 for character in endpoint):
            raise UsageError("API endpoint contains invalid whitespace or control characters.")
        url = API_BASE + endpoint
        if params:
            query = urlencode(params, doseq=True)
            url += ("&" if "?" in url else "?") + query
        return url

    def get_bytes(
        self, endpoint: str, params: Optional[Mapping[str, Any]] = None
    ) -> Tuple[bytes, Mapping[str, str]]:
        url = self._build_url(endpoint, params)
        request = Request(
            url,
            headers={
                "X-Figma-Token": self._token,
                "Accept": "application/json",
                "User-Agent": USER_AGENT,
            },
            method="GET",
        )
        try:
            with self._opener(request, timeout=self.timeout) as response:
                return response.read(), response.headers
        except HTTPError as exc:
            # Consume a small amount so the connection can be reused, but never
            # echo an untrusted response or request headers.
            detail = ""
            try:
                raw = exc.read(65536)
                payload = json.loads(raw.decode("utf-8"))
                if isinstance(payload, dict):
                    detail = _safe_api_detail(
                        payload.get("err") or payload.get("error") or payload.get("message"),
                        self._token,
                    )
            except Exception:
                detail = ""
            if exc.code in (401, 403):
                raise AuthError(
                    _auth_api_message(exc.code, detail),
                    status=exc.code,
                    detail=detail,
                ) from None
            labels = {
                404: "Figma resource was not found",
                429: "Figma rate limit exceeded; retry later",
            }
            if 500 <= exc.code <= 599:
                message = "Figma service error (HTTP {}); retry later".format(exc.code)
            else:
                message = "{} (HTTP {})".format(labels.get(exc.code, "Figma API request failed"), exc.code)
            if detail:
                message += ": " + detail
            raise ApiError(message, status=exc.code) from None
        except (URLError, socket.timeout, TimeoutError, http.client.HTTPException) as exc:
            reason = getattr(exc, "reason", exc)
            if isinstance(reason, (socket.timeout, TimeoutError)):
                raise ApiError("Figma API request timed out.") from None
            raise ApiError("Figma API network request failed.") from None
        except OSError:
            raise ApiError("Figma API network request failed.") from None

    def get_json(self, endpoint: str, params: Optional[Mapping[str, Any]] = None) -> Any:
        raw, _headers = self.get_bytes(endpoint, params)
        try:
            data = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError):
            raise ApiError("Figma API returned invalid JSON.") from None
        if isinstance(data, dict):
            err_value = data.get("err")
            error_value = data.get("error")
            status = data.get("status")
            numeric_error_status = (
                isinstance(status, (int, float)) and not isinstance(status, bool) and status >= 400
            )
            if bool(err_value) or bool(error_value) or status is False or numeric_error_status:
                detail_value = err_value or error_value or data.get("message")
                if not detail_value and numeric_error_status:
                    detail_value = "status {}".format(status)
                detail = _safe_api_detail(detail_value, self._token)
                status_code = (
                    int(status)
                    if numeric_error_status and float(status).is_integer()
                    else None
                )
                if status_code in (401, 403):
                    raise AuthError(
                        _auth_api_message(status_code, detail),
                        status=status_code,
                        detail=detail,
                    )
                raise ApiError(
                    "Figma API error{}".format(": " + detail if detail else "."),
                    status=status_code,
                )
        return data


def load_token(home: Optional[Path] = None, environ: Optional[Mapping[str, str]] = None) -> str:
    env = os.environ if environ is None else environ
    value = env.get("FIGMA_TOKEN", "").strip()
    if value:
        return value
    path = token_path(home)
    try:
        value = path.read_text(encoding="utf-8").strip()
    except FileNotFoundError:
        raise AuthError(
            "Figma token is not configured. Run '{} token set' or set FIGMA_TOKEN.".format(PROGRAM)
        ) from None
    except OSError as exc:
        raise AuthError("Cannot read Figma token file: {}.".format(path)) from exc
    if not value:
        raise AuthError("Figma token file is empty: {}.".format(path))
    return value


def atomic_write_bytes(path: Path, data: bytes, mode: Optional[int] = None) -> None:
    """Write bytes through a same-directory temporary file and os.replace."""
    parent = path.parent
    if not parent.is_dir():
        raise FileOperationError("Output directory does not exist: {}".format(parent))
    temp_name: Optional[str] = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb", prefix=".{}-".format(path.name), suffix=".tmp", dir=str(parent), delete=False
        ) as temp:
            temp_name = temp.name
            temp.write(data)
            temp.flush()
            os.fsync(temp.fileno())
        if mode is not None and os.name != "nt":
            os.chmod(temp_name, mode)
        os.replace(temp_name, str(path))
        temp_name = None
        if mode is not None and os.name != "nt":
            os.chmod(path, mode)
    except CliError:
        raise
    except OSError as exc:
        raise FileOperationError("Failed to write file '{}': {}".format(path, exc)) from None
    finally:
        if temp_name:
            try:
                os.unlink(temp_name)
            except OSError:
                pass


@dataclass(frozen=True)
class DownloadResult:
    path: Path
    size: int
    content_type: str
    final_url: str


@dataclass(frozen=True)
class StagedDownload:
    path: Path
    size: int
    content_type: str
    final_url: str


def _validate_download_url(url: str) -> None:
    try:
        parsed = urlsplit(url)
    except ValueError as exc:
        raise FileOperationError("Invalid download URL returned by Figma.") from exc
    if parsed.scheme.lower() not in {"http", "https"} or not parsed.hostname or parsed.username or parsed.password:
        raise FileOperationError("Invalid download URL returned by Figma.")
    if any(character.isspace() or ord(character) < 32 for character in url):
        raise FileOperationError("Invalid download URL returned by Figma.")


def download_to_temp(
    url: str,
    directory: Path,
    prefix: str = ".figma-download-",
    timeout: float = DEFAULT_TIMEOUT,
    opener: Callable[..., Any] = urlopen,
) -> StagedDownload:
    """GET a URL into a random, exclusive temporary file in ``directory``."""
    _validate_download_url(url)
    if not directory.is_dir():
        suggestion = " (Did you mean 'Downloads' with an 's'?)" if directory.name == "Download" else ""
        raise FileOperationError("Output directory does not exist: {}{}".format(directory, suggestion))
    safe_prefix = re.sub(r"[^A-Za-z0-9._-]", "_", prefix)[:80] or ".figma-download-"
    temp_name: Optional[str] = None
    content_type = ""
    final_url = url
    size = 0
    try:
        with tempfile.NamedTemporaryFile(
            mode="wb", prefix=safe_prefix, suffix=".tmp", dir=str(directory), delete=False
        ) as temp:
            temp_name = temp.name
            try:
                request = Request(url, headers={"User-Agent": USER_AGENT, "Accept": "*/*"}, method="GET")
                with opener(request, timeout=timeout) as response:
                    content_type = text(response.headers.get("Content-Type", "")).split(";", 1)[0].strip().lower()
                    geturl = getattr(response, "geturl", None)
                    if callable(geturl):
                        final_url = text(geturl()) or url
                    while True:
                        chunk = response.read(1024 * 128)
                        if not chunk:
                            break
                        temp.write(chunk)
                        size += len(chunk)
            except HTTPError as exc:
                raise FileOperationError("Download failed (HTTP {}).".format(exc.code)) from None
            except (URLError, socket.timeout, TimeoutError, OSError, ValueError, http.client.HTTPException):
                raise FileOperationError("Download network request failed.") from None
            temp.flush()
            os.fsync(temp.fileno())
        if size <= 0:
            raise FileOperationError("Download failed: received an empty file.")
        staged_path = Path(temp_name)
        temp_name = None
        return StagedDownload(staged_path, size, content_type, final_url)
    except CliError:
        raise
    except OSError as exc:
        raise FileOperationError("Failed to stage download: {}".format(exc)) from None
    finally:
        if temp_name:
            try:
                os.unlink(temp_name)
            except OSError:
                pass


def remove_staged_download(staged: StagedDownload) -> None:
    try:
        staged.path.unlink()
    except FileNotFoundError:
        pass
    except OSError:
        pass


def commit_staged_download(
    staged: StagedDownload, destination: Path, mode: int = 0o644
) -> DownloadResult:
    """Atomically install a validated same-directory download."""
    parent = destination.parent
    if not parent.is_dir():
        raise FileOperationError("Output directory does not exist: {}".format(parent))
    try:
        if not os.path.samefile(str(staged.path.parent), str(parent)):
            raise FileOperationError("Staged download is not in the destination directory.")
        if os.name != "nt":
            os.chmod(staged.path, mode)
        os.replace(str(staged.path), str(destination))
    except CliError:
        raise
    except OSError as exc:
        raise FileOperationError("Failed to save download '{}': {}".format(destination, exc)) from None
    return DownloadResult(destination, staged.size, staged.content_type, staged.final_url)


def download_atomic(
    url: str,
    destination: Path,
    timeout: float = DEFAULT_TIMEOUT,
    opener: Callable[..., Any] = urlopen,
) -> DownloadResult:
    """Stage a non-empty GET in the target directory, then atomically install it."""
    staged = download_to_temp(
        url,
        destination.parent,
        prefix=".{}-".format(destination.name),
        timeout=timeout,
        opener=opener,
    )
    try:
        return commit_staged_download(staged, destination)
    finally:
        remove_staged_download(staged)


def format_size(size: int) -> str:
    if size < 1024:
        return "{} B".format(size)
    if size < 1024 * 1024:
        return "{:.1f} KiB".format(size / 1024.0)
    return "{:.1f} MiB".format(size / (1024.0 * 1024.0))


def _read_file_edges(path: Path, head_limit: int = 262144, tail_limit: int = 65536) -> Tuple[bytes, bytes]:
    try:
        with path.open("rb") as stream:
            head = stream.read(head_limit)
            stream.seek(0, os.SEEK_END)
            size = stream.tell()
            stream.seek(max(0, size - tail_limit), os.SEEK_SET)
            tail = stream.read(tail_limit)
        return head, tail
    except OSError as exc:
        raise FileOperationError("Cannot inspect staged download: {}".format(exc)) from None


def _looks_like_svg(head: bytes, tail: bytes) -> bool:
    try:
        source = head.decode("utf-8-sig")
        ending = tail.decode("utf-8", "ignore")
    except UnicodeDecodeError:
        return False
    source = source.lstrip()
    # Permit ordinary XML declarations, comments, and a simple doctype before
    # the root element without accepting arbitrary HTML containing an SVG.
    for _unused in range(8):
        if source.startswith("<?"):
            end = source.find("?>")
            if end < 0:
                return False
            source = source[end + 2 :].lstrip()
            continue
        if source.startswith("<!--"):
            end = source.find("-->")
            if end < 0:
                return False
            source = source[end + 3 :].lstrip()
            continue
        if source[:9].upper() == "<!DOCTYPE":
            end = source.find(">")
            if end < 0:
                return False
            source = source[end + 1 :].lstrip()
            continue
        break
    root = re.match(r"<svg(?:\s|/?>)", source, re.IGNORECASE)
    if root is None:
        return False
    opening_end = source.find(">", root.start())
    if opening_end >= 0 and source[:opening_end].rstrip().endswith("/"):
        return True
    return re.search(r"</svg\s*>", source + ending, re.IGNORECASE) is not None


def validate_export_content(staged: StagedDownload, image_format: str) -> Tuple[bool, str]:
    """Validate a staged export by format signature/structure, independent of size."""
    if staged.size <= 0:
        return False, "empty response"
    head, tail = _read_file_edges(staged.path)
    normalized_type = staged.content_type.lower().split(";", 1)[0].strip()
    if normalized_type in {"application/json", "text/json", "text/html", "application/xhtml+xml"}:
        return False, "unexpected {} response".format(normalized_type)
    normalized_format = image_format.lower()
    if normalized_format == "png":
        valid = head.startswith(b"\x89PNG\r\n\x1a\n") and head[12:16] == b"IHDR" and b"IEND" in tail
        return valid, "invalid PNG signature or chunk structure"
    if normalized_format in {"jpg", "jpeg"}:
        valid = head.startswith(b"\xff\xd8\xff") and b"\xff\xd9" in tail[-32:]
        return valid, "invalid JPEG markers"
    if normalized_format == "pdf":
        valid = head.lstrip().startswith(b"%PDF-") and b"%%EOF" in tail
        return valid, "invalid PDF header or trailer"
    if normalized_format == "svg":
        valid = _looks_like_svg(head, tail)
        return valid, "invalid SVG root structure"
    # Future formats remain usable when the response is non-empty and does not
    # advertise a common API/HTML error content type.
    return True, ""


def extract_image_entry(response: Any, excluded_ids: Optional[Set[str]] = None) -> Tuple[str, str]:
    images = as_dict(as_dict(response).get("images"))
    excluded = excluded_ids or set()
    for node_id, value in images.items():
        if text(node_id) not in excluded and isinstance(value, str) and value and value != "null":
            return text(node_id), value
    return "", ""


def extract_image_entries(response: Any, excluded_ids: Optional[Set[str]] = None) -> List[Tuple[str, str]]:
    images = as_dict(as_dict(response).get("images"))
    excluded = excluded_ids or set()
    return [
        (text(node_id), value)
        for node_id, value in images.items()
        if text(node_id) not in excluded and isinstance(value, str) and value and value != "null"
    ]


def extract_image_url(response: Any) -> str:
    """Return the first non-null URL from an Images API response."""
    if isinstance(response, str):
        try:
            response = json.loads(response)
        except json.JSONDecodeError:
            return ""
    return extract_image_entry(response)[1]


def dedup_layout_children(children: Iterable[Any]) -> List[Dict[str, Any]]:
    """Drop invisible nodes and only exact duplicate, non-empty node IDs."""
    seen_ids: Set[str] = set()
    result: List[Dict[str, Any]] = []
    for raw in children:
        if not isinstance(raw, dict) or raw.get("visible") is False:
            continue
        node_id = text(raw.get("id")).strip()
        if node_id:
            if node_id in seen_ids:
                continue
            seen_ids.add(node_id)
        result.append(raw)
    return result


def filtered_layout_children(node: Mapping[str, Any]) -> List[Dict[str, Any]]:
    return dedup_layout_children(as_list(node.get("children")))


def filter_layout_tree(node: Any) -> Optional[Dict[str, Any]]:
    if not isinstance(node, dict) or node.get("visible") is False:
        return None
    output = {key: value for key, value in node.items() if key != "children"}
    children: List[Dict[str, Any]] = []
    for child in filtered_layout_children(node):
        filtered = filter_layout_tree(child)
        if filtered is not None:
            children.append(filtered)
    if children:
        output["children"] = children
    return output


def _layout_fill(node: Mapping[str, Any]) -> str:
    for fill in as_list(node.get("fills")):
        if not isinstance(fill, dict):
            continue
        if fill.get("type") == "SOLID":
            color = as_dict(fill.get("color"))
            try:
                red = int(float(color.get("r", 0)) * 255)
                green = int(float(color.get("g", 0)) * 255)
                blue = int(float(color.get("b", 0)) * 255)
            except (TypeError, ValueError):
                red = green = blue = 0
            red, green, blue = (max(0, min(255, item)) for item in (red, green, blue))
            return " bg:#{:02x}{:02x}{:02x}".format(red, green, blue)
        if fill.get("type") == "IMAGE":
            return " [IMAGE:{}]".format(text(fill.get("imageRef")))
    return ""


def format_layout_tree(node: Any, indent: int = 0) -> List[str]:
    if not isinstance(node, dict) or node.get("visible") is False:
        return []
    box = as_dict(node.get("absoluteBoundingBox"))
    width = box.get("width", "")
    height = box.get("height", "")
    x_value = box.get("x", "")
    y_value = box.get("y", "")
    size = " [{}x{}]".format(width, height) if width not in ("", None, 0) else ""
    position = " @({},{})".format(x_value, y_value) if x_value not in ("", None) else ""
    line = '{}{}: "{}"{}{}{}'.format(
        "  " * indent,
        text(node.get("type")),
        text(node.get("name")),
        size,
        position,
        _layout_fill(node),
    )
    lines = [line]
    for child in filtered_layout_children(node):
        lines.extend(format_layout_tree(child, indent + 1))
    return lines


def requested_node_document(data: Any, node_id: str, operation: str) -> Dict[str, Any]:
    """Return the exact requested node document or fail instead of empty success."""
    if not isinstance(data, dict) or not isinstance(data.get("nodes"), dict):
        raise ApiError("Figma {} response did not contain a nodes map.".format(operation))
    nodes = data["nodes"]
    if node_id not in nodes:
        raise ApiError("Requested node {} is missing from the Figma {} response.".format(node_id, operation))
    node_value = nodes[node_id]
    if not isinstance(node_value, dict):
        raise ApiError("Requested node {} was not found in the Figma file.".format(node_id))
    document = node_value.get("document")
    if not isinstance(document, dict) or not document:
        raise ApiError("Requested node {} has no document data.".format(node_id))
    return document


def find_image_refs(node: Any, found: Optional[List[str]] = None, seen: Optional[Set[str]] = None) -> List[str]:
    if found is None:
        found = []
    if seen is None:
        seen = set()
    if not isinstance(node, dict):
        return found
    for fill in as_list(node.get("fills")):
        if isinstance(fill, dict) and fill.get("type") == "IMAGE":
            image_ref = text(fill.get("imageRef"))
            if image_ref and image_ref not in seen:
                seen.add(image_ref)
                found.append(image_ref)
    for child in as_list(node.get("children")):
        find_image_refs(child, found, seen)
    return found


def sanitize_filename_component(value: str) -> str:
    """Turn an API-provided imageRef into one safe path component."""
    original = value
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "_", value.replace("/", "_").replace("\\", "_"))
    cleaned = cleaned.strip(". ")[:120]
    if not cleaned:
        cleaned = "image"
    windows_reserved = {"CON", "PRN", "AUX", "NUL"} | {
        "{}{}".format(prefix, number) for prefix in ("COM", "LPT") for number in range(1, 10)
    }
    if cleaned.split(".", 1)[0].upper() in windows_reserved:
        cleaned = "_" + cleaned
    if cleaned != original or cleaned in {".", ".."}:
        digest = hashlib.sha256(original.encode("utf-8", "replace")).hexdigest()[:10]
        cleaned = "{}_{}".format(cleaned[:100], digest)
    return cleaned


CONTENT_TYPE_EXTENSIONS = {
    "image/png": "png",
    "image/jpeg": "jpg",
    "image/jpg": "jpg",
    "image/gif": "gif",
    "image/webp": "webp",
    "image/svg+xml": "svg",
}


def infer_image_extension(url: str, content_type: str = "", final_url: str = "") -> str:
    for candidate in (final_url, url):
        try:
            suffix = Path(urlsplit(candidate).path).suffix.lower().lstrip(".")
        except ValueError:
            suffix = ""
        if suffix in {"png", "jpg", "jpeg", "gif", "webp", "svg"}:
            return "jpg" if suffix == "jpeg" else suffix
    normalized = content_type.lower().split(";", 1)[0].strip()
    if normalized in CONTENT_TYPE_EXTENSIONS:
        return CONTENT_TYPE_EXTENSIONS[normalized]
    guessed = mimetypes.guess_extension(normalized) if normalized else None
    if guessed in {".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"}:
        return "jpg" if guessed == ".jpeg" else guessed.lstrip(".")
    return "png" if "png" in url.lower() else "jpg"


def _image_response(
    client: FigmaClient,
    file_key: str,
    node_ids: Sequence[str],
    image_format: str,
    scale: str,
    absolute_bounds: bool = False,
) -> Any:
    params: Dict[str, Any] = {
        "ids": ",".join(node_ids),
        "format": image_format,
        "scale": scale,
    }
    if absolute_bounds:
        params["use_absolute_bounds"] = "true"
    return client.get_json("/images/{}".format(endpoint_segment(file_key)), params)


def instance_parent_id(node_id: str) -> str:
    if ";" not in node_id:
        return ""
    first = node_id.split(";", 1)[0]
    return first[1:] if first.startswith("I") else first


def find_ancestor_ids(root: Any, target_id: str) -> List[str]:
    """Return nearest-to-farthest ancestor IDs for target_id."""
    if not isinstance(root, dict):
        return []
    stack: List[Tuple[Dict[str, Any], List[str]]] = [(root, [])]
    while stack:
        node, ancestors = stack.pop()
        if text(node.get("id")) == target_id:
            return list(reversed([item for item in ancestors if item]))
        next_ancestors = ancestors + [text(node.get("id"))]
        children = as_list(node.get("children"))
        for child in reversed(children):
            if isinstance(child, dict):
                stack.append((child, next_ancestors))
    return []


def fetch_ancestor_ids(client: FigmaClient, file_key: str, node_id: str) -> List[str]:
    # The shallow request is cheap for common top-level nodes.  If it misses,
    # repeat with a deep tree, matching the canonical fallback's intent.
    for depth in (2, 99):
        data = client.get_json("/files/{}".format(endpoint_segment(file_key)), {"depth": depth})
        ancestors = find_ancestor_ids(as_dict(data).get("document"), node_id)
        if ancestors:
            return ancestors
    return []


NEARBY_OFFSETS = (
    -1, -2, -3, -4, -5, -6, -8, -10, -12, -15, -20, -25, -30, -40,
    -50, -60, -80, -100, -150, -200,
    1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 20, 25, 30, 40, 50, 60, 80, 100, 150, 200,
)


def nearby_node_ids(node_id: str) -> List[str]:
    match = re.fullmatch(r"(\d+):(\d+)", node_id)
    if not match:
        return []
    prefix, number_text = match.groups()
    number = int(number_text)
    return ["{}:{}".format(prefix, number + offset) for offset in NEARBY_OFFSETS if number + offset > 0][:40]


@dataclass(frozen=True)
class ExportImage:
    url: str
    rendered_node_id: str
    fallback: str = ""


def iter_export_images(
    client: FigmaClient,
    file_key: str,
    node_id: str,
    image_format: str,
    scale: str,
    include_direct: bool = True,
    excluded_ids: Optional[Set[str]] = None,
) -> Iterable[ExportImage]:
    """Lazily yield direct, bounds, parent, then nearby export candidates."""
    excluded = set(excluded_ids or set())
    seen_urls: Set[str] = set()
    if include_direct and node_id not in excluded:
        direct = _image_response(client, file_key, [node_id], image_format, scale)
        for found_id, image_url in extract_image_entries(direct, excluded):
            if image_url not in seen_urls:
                seen_urls.add(image_url)
                yield ExportImage(image_url, found_id or node_id)
        eprint("Trying export with absolute bounds...")
        absolute = _image_response(client, file_key, [node_id], image_format, scale, True)
        for found_id, image_url in extract_image_entries(absolute, excluded):
            if image_url not in seen_urls:
                seen_urls.add(image_url)
                yield ExportImage(image_url, found_id or node_id, "absolute bounds")

    attempted: Set[str] = {node_id} | excluded
    derived_parent = instance_parent_id(node_id)
    if derived_parent and derived_parent not in attempted:
        eprint("Instance export unavailable; trying parent node {}...".format(derived_parent))
        attempted.add(derived_parent)
        response = _image_response(client, file_key, [derived_parent], image_format, scale)
        for found_id, image_url in extract_image_entries(response, excluded):
            if image_url not in seen_urls:
                seen_urls.add(image_url)
                yield ExportImage(image_url, found_id or derived_parent, "Instance parent")

    eprint("Trying ordinary parent fallback...")
    ancestor_target = derived_parent or node_id
    ancestors = fetch_ancestor_ids(client, file_key, ancestor_target)
    for parent_id in ancestors[:8]:
        if parent_id in attempted:
            continue
        attempted.add(parent_id)
        response = _image_response(client, file_key, [parent_id], image_format, scale)
        for found_id, image_url in extract_image_entries(response, excluded):
            if image_url not in seen_urls:
                seen_urls.add(image_url)
                yield ExportImage(image_url, found_id or parent_id, "parent node")

    eprint("Trying nearby renderable nodes...")
    candidates = [item for item in nearby_node_ids(ancestor_target) if item not in attempted]
    if candidates:
        response = _image_response(client, file_key, candidates, image_format, scale)
        for found_id, image_url in extract_image_entries(response, excluded):
            if image_url not in seen_urls:
                seen_urls.add(image_url)
                yield ExportImage(image_url, found_id, "nearby node")


def resolve_export_image(
    client: FigmaClient,
    file_key: str,
    node_id: str,
    image_format: str,
    scale: str,
    fallback_only: bool = False,
    excluded_ids: Optional[Set[str]] = None,
) -> ExportImage:
    """Compatibility helper returning the first available export URL."""
    for candidate in iter_export_images(
        client,
        file_key,
        node_id,
        image_format,
        scale,
        include_direct=not fallback_only,
        excluded_ids=excluded_ids,
    ):
        return candidate
    raise ApiError(
        "No image URL was returned after direct, absolute-bounds, parent, and nearby-node attempts. "
        "The node may be hidden, empty, or a non-renderable component definition."
    )


def split_flags(
    args: Sequence[str], allowed_values: Set[str], allowed_switches: Optional[Set[str]] = None
) -> Tuple[List[str], Dict[str, str], Set[str]]:
    positionals: List[str] = []
    values: Dict[str, str] = {}
    switches: Set[str] = set()
    switch_names = allowed_switches or set()
    for arg in args:
        if not arg.startswith("--"):
            positionals.append(arg)
            continue
        if arg in switch_names:
            switches.add(arg)
            continue
        if "=" not in arg:
            raise UsageError("Option '{}' must use --name=value syntax.".format(arg))
        name, value = arg.split("=", 1)
        if name not in allowed_values:
            raise UsageError("Unknown option: {}".format(name))
        if value == "":
            raise UsageError("Option {} requires a value.".format(name))
        values[name] = value
    return positionals, values, switches


def validate_scale(value: str) -> str:
    try:
        number = float(value)
    except ValueError:
        raise UsageError("scale must be a number between 0.01 and 4.") from None
    if not (0.01 <= number <= 4.0):
        raise UsageError("scale must be between 0.01 and 4.")
    return value


def validate_export_format(value: str) -> str:
    lowered = value.lower()
    if lowered == "jpeg":
        lowered = "jpg"
    if lowered not in {"png", "jpg", "svg", "pdf"}:
        raise UsageError("format must be one of: png, jpg, svg, pdf.")
    return lowered


@dataclass(frozen=True)
class ExportArguments:
    file_key: str
    node_id: str
    image_format: str
    scale: str
    output: Path


def parse_export_arguments(
    args: Sequence[str], screenshot: bool = False, validate_output: bool = True
) -> ExportArguments:
    allowed = {"--scale", "--output"} if screenshot else {"--format", "--scale", "--output"}
    positionals, flags, _switches = split_flags(args, allowed)
    command = "screenshot" if screenshot else "export"
    file_key, node_id, remaining = parse_file_and_node(positionals, command)
    if screenshot:
        if len(remaining) > 2:
            raise UsageError("Usage: {} screenshot <url> [output] [scale]".format(PROGRAM))
        output_text = remaining[0] if remaining else ""
        scale = remaining[1] if len(remaining) > 1 else "2"
        image_format = "png"
    else:
        if len(remaining) > 3:
            raise UsageError("Usage: {} export <url> [format] [scale] [output]".format(PROGRAM))
        image_format = remaining[0] if remaining else "png"
        scale = remaining[1] if len(remaining) > 1 else "2"
        output_text = remaining[2] if len(remaining) > 2 else ""
    image_format = validate_export_format(flags.get("--format", image_format))
    scale = validate_scale(flags.get("--scale", scale))
    output_text = flags.get("--output", output_text)
    default_output = not bool(output_text)
    if output_text:
        output = Path(output_text).expanduser()
    else:
        prefix = "figma_screenshot" if screenshot else "figma_export"
        output = Path.home() / "Downloads" / "{}_{}.{}".format(
            prefix, datetime.now().strftime("%Y%m%d_%H%M%S"), image_format
        )
    if output.name in {"", ".", ".."}:
        raise FileOperationError("Output path must name a file.")
    if validate_output and default_output:
        try:
            output.parent.mkdir(parents=True, exist_ok=True)
        except OSError as exc:
            raise FileOperationError("Cannot create default Downloads directory '{}': {}".format(output.parent, exc)) from None
    if validate_output and not output.parent.is_dir():
        suggestion = " (Did you mean 'Downloads' with an 's'?)" if output.parent.name == "Download" else ""
        raise FileOperationError("Output directory does not exist: {}{}".format(output.parent, suggestion))
    return ExportArguments(file_key, node_id, image_format, scale, output)


def handle_export(
    client: FigmaClient,
    args: Sequence[str],
    screenshot: bool = False,
    download_opener: Callable[..., Any] = urlopen,
) -> None:
    options = parse_export_arguments(args, screenshot=screenshot)
    eprint(
        "Exporting node {} from file {} as {} (scale: {}x)...".format(
            options.node_id, options.file_key, options.image_format, options.scale
        )
    )
    eprint("Downloading to: {}".format(options.output))
    saw_candidate = False
    last_failure = ""
    for selected in iter_export_images(
        client, options.file_key, options.node_id, options.image_format, options.scale
    ):
        saw_candidate = True
        staged: Optional[StagedDownload] = None
        try:
            staged = download_to_temp(
                selected.url,
                options.output.parent,
                prefix=".{}-candidate-".format(options.output.name),
                opener=download_opener,
            )
            valid, reason = validate_export_content(staged, options.image_format)
        except FileOperationError as exc:
            last_failure = exc.message
            eprint("Export candidate download failed; trying the next fallback: {}".format(exc.message))
            if staged is not None:
                remove_staged_download(staged)
            continue
        if not valid:
            last_failure = reason
            eprint("Export candidate was not valid {} data ({}); trying fallback...".format(
                options.image_format.upper(), reason
            ))
            remove_staged_download(staged)
            continue
        if selected.fallback:
            eprint(
                "Warning: using {} {}. The downloaded image may not be the exact requested node.".format(
                    selected.fallback, selected.rendered_node_id
                )
            )
        try:
            result = commit_staged_download(staged, options.output)
        finally:
            remove_staged_download(staged)
        print("Done! Saved: {} ({})".format(options.output, format_size(result.size)))
        return
    if saw_candidate:
        raise FileOperationError(
            "All export candidates failed download or content validation{}.".format(
                ": " + last_failure if last_failure else ""
            )
        )
    raise ApiError(
        "No image URL was returned after direct, absolute-bounds, parent, and nearby-node attempts."
    )


def handle_layout(client: FigmaClient, args: Sequence[str]) -> None:
    positionals, _flags, switches = split_flags(args, set(), {"--json"})
    file_key, node_id, remaining = parse_file_and_node(positionals, "layout")
    if remaining:
        raise UsageError("Usage: {} layout <url> [--json]".format(PROGRAM))
    eprint("Fetching layout for node {} from file {}...".format(node_id, file_key))
    data = client.get_json(
        "/files/{}/nodes".format(endpoint_segment(file_key)),
        {"ids": node_id, "geometry": "paths"},
    )
    document = requested_node_document(data, node_id, "layout")
    if "--json" in switches:
        filtered = filter_layout_tree(document)
        if filtered is None:
            raise ApiError("Requested layout node is invisible.")
        print(json.dumps(filtered, ensure_ascii=False, separators=(",", ":")))
    else:
        lines = format_layout_tree(document)
        if not lines:
            raise ApiError("Requested layout node is invisible.")
        for line in lines:
            print(line)


def _download_asset(
    image_ref: str,
    url: str,
    output_dir: Path,
    opener: Callable[..., Any] = urlopen,
) -> DownloadResult:
    safe_ref = sanitize_filename_component(image_ref)
    staged = download_to_temp(
        url,
        output_dir,
        prefix=".{}-asset-".format(safe_ref),
        opener=opener,
    )
    try:
        extension = infer_image_extension(url, staged.content_type, staged.final_url)
        destination = output_dir / "{}.{}".format(safe_ref, extension)
        return commit_staged_download(staged, destination)
    finally:
        remove_staged_download(staged)


def handle_images(client: FigmaClient, args: Sequence[str]) -> None:
    positionals, _flags, _switches = split_flags(args, set())
    file_key, node_id, remaining = parse_file_and_node(positionals, "images")
    if len(remaining) > 1:
        raise UsageError("Usage: {} images <url> [output_dir]".format(PROGRAM))
    explicit_output = bool(remaining)
    output_dir = Path(remaining[0]).expanduser() if explicit_output else Path.home() / "Downloads" / "figma_assets"
    if output_dir.exists() or output_dir.is_symlink():
        if not output_dir.is_dir():
            raise FileOperationError("Asset output path is not a directory: {}".format(output_dir))
    elif explicit_output and not output_dir.parent.is_dir():
        raise FileOperationError(
            "Output directory parent does not exist: {}".format(output_dir.parent)
        )
    try:
        output_dir.mkdir(parents=not explicit_output, exist_ok=True)
    except OSError as exc:
        raise FileOperationError("Cannot create output directory '{}': {}".format(output_dir, exc)) from None
    if not output_dir.is_dir():
        raise FileOperationError("Asset output path is not a directory: {}".format(output_dir))

    eprint("Fetching image fills from node {}...".format(node_id))
    node_data = client.get_json(
        "/files/{}/nodes".format(endpoint_segment(file_key)), {"ids": node_id}
    )
    document = requested_node_document(node_data, node_id, "images")
    references: List[str] = []
    seen: Set[str] = set()
    find_image_refs(document, references, seen)
    if not references:
        print("No image fills found in this node.")
        return
    eprint("Found {} unique image refs.".format(len(references)))
    image_data = client.get_json("/files/{}/images".format(endpoint_segment(file_key)))
    image_map = as_dict(as_dict(as_dict(image_data).get("meta")).get("images"))
    for image_ref in references:
        image_url = image_map.get(image_ref)
        if not isinstance(image_url, str) or not image_url:
            eprint("No download URL for image ref: {}".format(sanitize_filename_component(image_ref)))
            continue
        eprint("Downloading image ref {}...".format(sanitize_filename_component(image_ref)))
        result = _download_asset(image_ref, image_url, output_dir)
        print("Saved: {} ({})".format(result.path, format_size(result.size)))
    print("Done! Assets saved to: {}".format(output_dir))


