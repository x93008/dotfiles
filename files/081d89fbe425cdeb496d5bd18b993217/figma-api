class _FakeDownloadResponse(io.BytesIO):
    """Minimal urllib response used only by the offline self-test."""

    def __init__(self, body: bytes, content_type: str, final_url: str) -> None:
        super().__init__(body)
        self.headers = {"Content-Type": content_type}
        self._final_url = final_url

    def geturl(self) -> str:
        return self._final_url

    def __enter__(self) -> "_FakeDownloadResponse":
        return self

    def __exit__(self, *args: object) -> None:
        self.close()


